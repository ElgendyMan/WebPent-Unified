# WebPent — البيئة المبدئية (10 أسطر بس للبداية السريعة)
# انسخ الملف ده إلى .env وعدّل القيم:
#   cp .env.minimal.example .env
#
# للتخصيص الكامل (201 سطر): راجع .env.example و.env.llm.example
# ممنوع أبداً: commit ملف .env أو أي مفتاح حقيقي أو credentials.

# 1) شغّل المسار الحتمي بدون LLM (الأسهل للبداية) — غيّرها إلى true بعد إضافة مفتاح
LLM_ENABLED=false

# 2) مفتاح مزود واحد يكفي (اختياري لو LLM_ENABLED=true) — احذف علامة # وحط مفتاحك
# ANTHROPIC_API_KEY=CHANGE-ME

# 3) قاعدة البيانات (الافتراضي شغّال زي ما هو — SQLite محلي)
DATABASE_URL=file:./webpent.db

# 4) الحد الأقصى لخطوات الجراف — الميزانية الديناميكية (2026-10-27) تحسب
#    القيمة الفعلية من حجم السطح، وده بقى السقف الصلب فقط
MAX_GRAPH_STEPS=50

# 5) مستوى اللوج
LOG_LEVEL=INFO
