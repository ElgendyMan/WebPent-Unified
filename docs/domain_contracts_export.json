      }
    },
    "Observation": {
      "client_scoping_field": "engagement_id",
      "data_type": "hypotheses",
      "entity": "webpent.models.evidence.Observation",
      "schema_version": "webpent-observation-v1",
      "scope": "engagement",
      "source_of_truth": {
        "owner_module": "webpent.models.hypothesis",
        "store": "graph state (LangGraph channel) + sqlite where persisted"
      }
    },
    "ProofBundle": {
      "client_scoping_field": "engagement_id",
