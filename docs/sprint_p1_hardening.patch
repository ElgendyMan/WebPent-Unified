--- a/tests/test_p1_exception_hygiene.py
+++ b/tests/test_p1_exception_hygiene.py
@@ -0,0 +1,35 @@
+from __future__ import annotations
+
+import ast
+import hashlib
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+CRITICAL_FILES = (
+    "src/webpent/production/autonomous_validation_v1.py",
+    "src/webpent/production/validators.py",
+    "src/webpent/shared/http.py",
+    "src/webpent/production/modern_spine.py",
+    "src/webpent/production/context_authority.py",
+    "src/webpent/shared/fixture_registry.py",
+    "src/webpent/shared/untrusted_content.py",
+    "src/webpent/graph/builder.py",
+    "src/webpent/agents/validator/agent.py",
+)
+FROZEN_TOOL_BOUNDARY_SHA256 = "c46608c3add66d66898ede7b9e89345c3ddaa7cc14bf624ae1ccac57cf2a0cd0"
+
+
+def test_named_critical_modules_have_no_broad_exception_handlers():
+    violations = []
+    for relative in CRITICAL_FILES:
+        tree = ast.parse((ROOT / relative).read_text(), filename=relative)
+        for node in ast.walk(tree):
+            if isinstance(node, ast.ExceptHandler) and isinstance(node.type, ast.Name) and node.type.id == "Exception":
+                violations.append(f"{relative}:{node.lineno}")
+    assert violations == []
+
+
+def test_frozen_tool_boundary_is_byte_identical():
+    path = ROOT / "src/webpent/llm_researcher/tool_boundary.py"
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == FROZEN_TOOL_BOUNDARY_SHA256
--- a/tests/test_p1_webhook_lifecycle.py
+++ b/tests/test_p1_webhook_lifecycle.py
@@ -0,0 +1,66 @@
+from __future__ import annotations
+
+import asyncio
+
+from webpent.integrations import webhook
+from webpent.service.cost_alerts import AlertDispatcher
+from webpent.service.facade import MultiCampaignService
+from webpent.service.models import CampaignSpec
+from webpent.service.store import ServiceStore
+
+
+def _spec(name: str) -> CampaignSpec:
+    return CampaignSpec(campaign_id=name, target_url="http://target.test", budget_limit=10, max_actions=5)
+
+
+def test_promoted_lifecycle_uses_signed_webhook_path(monkeypatch, tmp_path):
+    calls = []
+
+    async def fake_push(finding, url):
+        calls.append((finding, url))
+        return True
+
+    monkeypatch.setattr(webhook, "push_to_webhook", fake_push)
+    dispatcher = AlertDispatcher(ServiceStore(tmp_path / "s.sqlite"), webhook_url="https://hooks.example.test/webpent")
+    from webpent.service.models import FindingEvent
+    assert dispatcher.finding(FindingEvent(
+        campaign_id="camp", finding_id="find-1", status="promoted", severity="high",
+        title="XSS reflected", evidence_ref="proof:1", payload={
+            "finding_id": "find-1", "vulnerability_type": "XSS", "route": "/search",
+            "cvss_score": "8.2",
+        },
+    )) is True
+    assert len(calls) == 1
+    finding, url = calls[0]
+    assert url.startswith("https://")
+    assert finding.campaign_id == "camp"
+    assert finding.route == "/search"
+    assert finding.confidence_level == "Tool-Confirmed"
+
+
+def test_refuted_is_disabled_by_default_and_completion_is_idempotent(monkeypatch, tmp_path):
+    calls = []
+
+    async def fake_push(finding, url):
+        calls.append(finding.title)
+        return True
+
+    monkeypatch.setattr(webhook, "push_to_webhook", fake_push)
+    dispatcher = AlertDispatcher(ServiceStore(tmp_path / "s.sqlite"), webhook_url="https://hooks.example.test/webpent")
+    from webpent.service.models import FindingEvent
+    assert dispatcher.finding(FindingEvent(
+        campaign_id="camp", finding_id="find-1", status="refuted", title="Not real", payload={}
+    )) is False
+    assert dispatcher.campaign_complete("camp", findings=1, cost=0.5, duration_seconds=2.0) is True
+    assert dispatcher.campaign_complete("camp", findings=1, cost=0.5, duration_seconds=2.0) is False
+    assert calls == ["Campaign camp completed"]
+
+
+def test_facade_completion_emits_campaign_event_to_injected_sender(tmp_path):
+    delivered = []
+    service = MultiCampaignService(root=tmp_path, sender=lambda payload: delivered.append(payload) or True)
+    service.plan(_spec("camp"))
+    service.start("camp")
+    result = service.complete("camp")
+    assert result["state"] == "COMPLETED"
+    assert any(item.get("event") == "campaign.completed" for item in delivered)
--- a/tests/test_p1_xss_sqli.py
+++ b/tests/test_p1_xss_sqli.py
@@ -0,0 +1,99 @@
+from __future__ import annotations
+
+from webpent.production.validators import (
+    VALIDATORS,
+    ValidationOutcome,
+    validate_sqli,
+    validate_xss,
+)
+
+
+def _ev(status: int, body: str = "", *, content_type: str = "text/html", **extra):
+    return {
+        "status_code": status,
+        "response_body": body,
+        "headers": {"content-type": content_type},
+        **extra,
+    }
+
+
+def test_xss_unencoded_script_is_confirmed():
+    payload = "<script>alert(1)</script>"
+    result = validate_xss(
+        baseline=_ev(200, "<html>safe</html>"),
+        candidate=_ev(200, f"<html>{payload}</html>", structured_fields={"payload": payload}),
+        negative_control=_ev(200, "<html>safe</html>", structured_fields={"payload": payload}),
+    )
+    assert result.outcome is ValidationOutcome.CONFIRMED
+    assert result.details["reflection_context"] == "html_body"
+
+
+def test_xss_encoded_script_is_refuted():
+    payload = "<script>alert(1)</script>"
+    result = validate_xss(
+        baseline=_ev(200, "<html>safe</html>"),
+        candidate=_ev(200, "<html>&lt;script&gt;alert(1)&lt;/script&gt;</html>", structured_fields={"payload": payload}),
+        negative_control=_ev(200, "<html>safe</html>", structured_fields={"payload": payload}),
+    )
+    assert result.outcome is ValidationOutcome.REFUTED
+
+
+def test_xss_missing_reflection_is_inconclusive():
+    payload = "webpent_xss_test_12345"
+    result = validate_xss(
+        baseline=_ev(200, "<html>safe</html>"),
+        candidate=_ev(200, "<html>still safe</html>", structured_fields={"payload": payload}),
+        negative_control=_ev(200, "<html>safe</html>", structured_fields={"payload": payload}),
+    )
+    assert result.outcome is ValidationOutcome.INCONCLUSIVE
+
+
+def test_xss_comment_reflection_is_not_confirmed():
+    payload = "webpent_xss_test_12345"
+    result = validate_xss(
+        baseline=_ev(200, "<html>safe</html>"),
+        candidate=_ev(200, f"<!--{payload}-->", structured_fields={"payload": payload}),
+        negative_control=_ev(200, "<html>safe</html>", structured_fields={"payload": payload}),
+    )
+    assert result.outcome is ValidationOutcome.REFUTED
+
+
+def test_sqli_candidate_only_sqlstate_is_confirmed():
+    result = validate_sqli(
+        baseline=_ev(200, "login failed", content_type="application/json"),
+        candidate=_ev(500, "SQLSTATE[42000]: syntax error", content_type="application/json"),
+        negative_control=_ev(400, "invalid input", content_type="application/json"),
+    )
+    assert result.outcome is ValidationOutcome.CONFIRMED
+
+
+def test_sqli_identical_response_is_refuted():
+    result = validate_sqli(
+        baseline=_ev(200, "no results", content_type="application/json"),
+        candidate=_ev(200, "no results", content_type="application/json", structured_fields={"payload": "' OR '1'='1"}),
+        negative_control=_ev(200, "no results", content_type="application/json"),
+    )
+    assert result.outcome is ValidationOutcome.REFUTED
+
+
+def test_sqli_boolean_differential_is_confirmed():
+    result = validate_sqli(
+        baseline=_ev(200, "one result", content_type="application/json"),
+        candidate=_ev(200, "many results " + ("x" * 200), content_type="application/json", structured_fields={"payload": "' OR '1'='1"}),
+        negative_control=_ev(200, "one result", content_type="application/json"),
+    )
+    assert result.outcome is ValidationOutcome.CONFIRMED
+
+
+def test_sqli_ambiguous_difference_is_inconclusive():
+    result = validate_sqli(
+        baseline=_ev(200, "short", content_type="application/json"),
+        candidate=_ev(200, "slightly different", content_type="application/json"),
+        negative_control=_ev(200, "control", content_type="application/json"),
+    )
+    assert result.outcome is ValidationOutcome.INCONCLUSIVE
+
+
+def test_xss_and_sqli_are_registered():
+    assert "XSS" in VALIDATORS
+    assert "SQLI" in VALIDATORS
