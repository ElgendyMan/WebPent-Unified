, "version": 1, "vulnerabilities": [{"affects": [{"ref": "BomRef.034847877018232554.07578989713507434"}], "bom-ref": "BomRef.7287255706505207.5247739180201721", "description": "A pre-authentication, code injection vulnerability in version 1.0.0 or later of the ChromaDB Python project allows an unauthenticated attacker to run arbitrary code on the server by sending a malicious model repository and trust_remote_code set to true in the\u00a0/api/v2/tenants/{tenant}/databases/{db}/collections endpoint.", "id": "PYSEC-2026-311", "recommendation": "Upgrade"}, {"affects": [{"ref": "BomRef.034847877018232554.07578989713507434"}], "bom-ref": "BomRef.997957973224966.3080316036896392", "description": "A lack of authorization validation in version 0.4.17 or later of the ChromaDB Python project allows any authenticated users to arbitrarily read, write, update, or delete data in any tenant's collection regardless of which tenant they belong to.", "id": "PYSEC-2026-3813", "recommendation": "Upgrade"}, {"affects": [{"ref": "BomRef.034847877018232554.07578989713507434"}], "bom-ref": "BomRef.46681432192509953.7719013698976939", "description": "A code injection vulnerability in version 0.4.17 or later of the ChromaDB Python project allows an authenticated attacker to run arbitrary code on the server by sending a malicious model repository and trust_remote_code set to true in the\u00a0/api/v2/tenants/default_tenant/databases/default_database/collections/{collection_id} if they have the UPDATE_COLLECTION permission.", "id": "PYSEC-2026-3814", "recommendation": "Upgrade"}, {"affects": [{"ref": "BomRef.034847877018232554.07578989713507434"}], "bom-ref": "BomRef.7518331349889892.166352893267673", "description": "The SimpleRBACAuthorizationProvider authorization provider in versions 0.5.0 or later of the ChromaDB Python project evaluates whether a user holds a given permission but never checks which tenant, database, or collection that permission applies to allowing users to perform cross tenant actions.", "id": "PYSEC-2026-3815", "recommendation": "Upgrade"}], "$schema": "http://cyclonedx.org/schema/bom-1.4.schema.json", "bomFormat": "CycloneDX", "specVersion": "1.4"}
