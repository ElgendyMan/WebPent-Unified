# Copy to .env.llm locally and fill only the provider keys you are authorized to use.
# This file is gitignored. Never commit or paste real values into chat.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=
ZAI_API_KEY=
OLLAMA_URL=http://localhost:11434
WEBPENT_LLM_KEYS_FILE=.llm_keys.json

# --- Project Zero advisory wiring (all default-off, additive only) ---
# Each flag gates one passive, fail-soft advisory call site. None of them
# sends requests, promotes findings, or changes confirmation semantics.
# NOTE: Settings has no env_prefix — these are the bare env names.
# ENABLE_SURFACE_INFLUENCE_GRAPH=true
# ENABLE_SURFACE_DRIFT_ANALYSIS=true
# ENABLE_TECH_STACK_CVE_CORRELATION=true
# ENABLE_TAINT_TRACKING=true
# ENABLE_RED_VS_BLUE_SELFCHECK=true
# Optional local JSON catalogs for the advisory CVE/KEV feeds (empty = off):
# CVE_FEED_CATALOG_PATH=/path/to/cve_feed_catalog.json
# KEV_CATALOG_PATH=/path/to/kev_catalog.json

# --- VIP autonomous campaign layer (2026-10-24, opt-in) ---
# Two opt-in paths, both advisory-only (the leader never sends requests
# and never promotes findings; "act" is always a caller-provided hook):
# 1. Code API: an operator constructs VipOrchestratorConfig +
#    run_vip_campaign directly and supplies the executor hooks.
# 2. Graph node (layer 2): ENABLE_VIP_ORCHESTRATOR=true registers the
#    one-shot vip_orchestrator node after the disclosed-intel stage; it
#    runs an in-process perceive->plan pass over already-crawled data
#    and records advisory actions in state (vip_campaign_state).
# The CVE feed for its N-day perception reuses CVE_FEED_CATALOG_PATH
# above; in the graph the feed arrives via state cve_feed_catalog
# (operator file path: cve_feed_catalog_path).
